# Copy to .env (gitignored) and fill real values. Nothing here is a secret.
#
# ROOT IS THE SOURCE OF TRUTH for Compose-level configuration: this file is
# the only Compose environment template in the repository, read by the single
# root docker-compose.yml (docker compose also auto-loads ./.env for variable
# interpolation). The backend reads its OWN runtime configuration (Mongo/JWT/
# SMTP/Cloudinary/every PETGPT_* var) from backend/.env via `env_file` - see
# backend/.env.example for that complete list. That split is deliberate:
# backend/.env also feeds local (non-Docker) runs, where dotenv loads it from
# the backend working directory.
# Fill real secrets into your LOCAL .env files only and never commit them.

# Public host port the app is published on (nginx listens on 80 inside).
APP_PORT=8080

# API base baked into the React bundle at build time.
# "/api" = same-origin through the nginx reverse proxy. Change only for a
# split-origin deployment:
#   docker compose build --build-arg VITE_API_URL=https://api.example.com/api frontend
VITE_API_URL=/api

# Public origin the backend uses for emailed deep links (verify/reset) + CORS.
# Must match the hostname users actually browse to, or the emailed links break.
#
# It MUST also list every origin the app is actually served from, comma-separated.
# A tunnel makes the app same-origin, but the browser still sends an Origin header
# on every POST/PUT/PATCH/DELETE (never on same-origin GET/HEAD). The backend
# checks that header against this list, so an origin missing here fails every
# write - login, settings - while reads keep working and the app looks
# healthy. Add the tunnel hostname alongside localhost:
#   CLIENT_URL=http://localhost:8080,https://your-public-host
CLIENT_URL=http://localhost:8080

# Cloudflare tunnel token. cloudflared starts with the normal stack
# (`docker compose up`, no profile needed). With no valid token the
# cloudflared container keeps restarting - the rest of the stack is
# unaffected - so fill this when you use the public tunnel.
# The public hostname -> http://nginx:80 mapping lives in the Cloudflare
# Zero Trust dashboard, not here.
TUNNEL_TOKEN=

# ---------------------------------------------------------------
# The AI endpoint PetGPT uses. This is APPLICATION-LEVEL: there are
# no per-user AI providers and no per-user API keys anywhere in the
# app. Leave all three unset and PetGPT stays disabled - every
# generation fails safely with a "provider" error, and the app is
# otherwise fully usable.
#
# This is a plain OpenAI-compatible base URL. The implementation behind
# it (a gateway, a proxy, a self-hosted server, a remote provider) is
# the deployment's business - FamiPet only needs base URL + key + model.
#
# Set in backend/.env (that file is the one the backend actually reads):
#   PETGPT_OPENAI_BASE_URL=http://host.docker.internal:<port>/v1
#   PETGPT_OPENAI_API_KEY=...
#   PETGPT_OPENAI_MODEL=...
# `host.docker.internal` resolves to the host gateway, so it is the right
# address for an endpoint that runs on the host but is published on more
# than loopback. A container IP (172.x) is never used - it changes on
# every recreate.
# ---------------------------------------------------------------
