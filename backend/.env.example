# =========================================================
# FAMIPET - BACKEND ENVIRONMENT EXAMPLE
# Copy this file to `.env` and fill in real values. docker-compose.yml
# loads ./backend/.env into the backend container at runtime via
# env_file, so `.env` must NEVER be committed or baked into an image.
# Only placeholder values live here.
# =========================================================

PORT=5000
MONGODB_URI=mongodb://localhost:27017/petDB
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=30d

# ------------------------------------------------------------
# CORS / FRONTEND URL CONFIGURATION
# CLIENT_URL   – Origin allowed for CORS + fallback for legacy code.
#                 Dev-only: https://172.30.240.1
# FRONTEND_URL – Used to build ALL emailed links (verification, password
#                 reset). This is the canonical public-facing frontend URL.
#   LOCAL/LAN (HTTPS via Caddy on 443): set to this PC's CURRENT LAN IP,
#                 https://192.168.0.103  (phone + PC on the same Wi-Fi; the
#                 phone must trust the mkcert root CA for local development).
#   PRODUCTION:   https://<actual-production-domain>  (HTTPS, public,
#                 never localhost / LAN / Docker-internal)
# The production server will REFUSE to send emails if FRONTEND_URL is
# a localhost / LAN IP — link generation fails fast instead of sending
# broken links that cannot be opened from another device.
# BACKEND_URL mirrors the deployed backend URL for reference/deployment tooling.
# ------------------------------------------------------------

CLIENT_URL=https://172.30.240.1

# Set to "production" when deploying. Triggers the HTTPS-only FRONTEND_URL
# enforcement so localhost/LAN values cannot produce broken emailed links.
# NODE_ENV=production

FRONTEND_URL=https://192.168.0.103
BACKEND_URL=http://localhost:5000

# Set to "json" to run tests without sending real emails.
# Set to "quota-sim" to simulate Gmail daily-limit errors in tests.
# EMAIL_TRANSPORT=

# SMTP / email settings used by config/email.js
# EMAIL_SERVICE=gmail
# EMAIL_USER=you@gmail.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx

# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Google Gemini API key used by PetGPT (backend only, never sent to the frontend).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
