PORT=5000
# Only source of truth for the database. The Compose stack injects
# mongodb://mongodb:27017/petDB (docker-compose.yml also sets it in the
# backend `environment:` block, which wins over this file). There is no
# localhost default on purpose: inside a container "localhost" is the
# container itself. Running outside Docker? Point this at your own mongod.
MONGODB_URI=mongodb://mongodb:27017/petDB
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5500
# SMTP / email transport used by config/email.js. Unset = mail is not
# delivered (registration/reset flows fail visibly, the app still runs).
# EMAIL_SERVICE=gmail
# EMAIL_USER=
# EMAIL_PASS=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# LOG_LEVEL=info

# ---- PetGPT AI configuration (backend/config/ai.js) ----
# APPLICATION-LEVEL ONLY. FamiPet talks to exactly ONE generic
# OpenAI-compatible chat-completions endpoint. There are no per-user
# providers, no per-user API keys, and no provider selection: the whole
# AI feature is configured with these three variables.
#
# Base URL is the chat-completions ROOT; the adapter appends
# /chat/completions. No trailing slash. Whatever sits behind it (a
# hosted provider, a gateway, a proxy, a self-hosted server) is the
# deployment's business - FamiPet only needs base URL + key + model.
# The API key is never logged, echoed in an error, or returned to a client.
#
# DEFAULT PROVIDER - OmniRoute. FamiPet's own OpenAI-compatible gateway,
# expected on the deployment host at http://localhost:20128/v1. It is
# addressed on localhost by design: it is a host-local service, so its
# address is a property of the machine FamiPet runs on, never of this
# repo. These three values are the whole configuration:
#   PETGPT_OPENAI_BASE_URL=http://localhost:20128/v1
#   PETGPT_OPENAI_API_KEY=dummy-key
#   PETGPT_OPENAI_MODEL=free-chat
# `dummy-key` is a PLACEHOLDER, not a secret. OmniRoute accepts any
# non-empty bearer value on /v1/chat/completions (only /v1/models, which
# FamiPet never calls, validates it). Point this at a hosted provider and
# the real key goes in the gitignored backend/.env - never in this file.
# `free-chat` is OmniRoute's model alias that routes each request to a
# free upstream.
#
# Limits every request (timeouts / question length, milliseconds / chars).
# PETGPT_TIMEOUT_MS=25000
# PETGPT_MAX_QUESTION_LENGTH=2000

# ---- PetGPT conversation/history limits (backend/config/ai.js) ----
# Prior user/assistant messages fed to the provider as context per exchange.
# PETGPT_MAX_HISTORY_MESSAGES=20

# ---- PetGPT durable generation worker (backend/config/ai.js) ----
# In-process poller for queued GenerationJobs. pollMs = tick interval;
# staleMs = how long a "processing" job may sit before it is re-enqueued
# (attempts left) or failed (attempts exhausted); maxAttempts bounds retries
# (no infinite retry loop). Single worker process; docs in petGPT.md §18.
# PETGPT_WORKER_POLL_MS=300
# PETGPT_WORKER_STALE_MS=60000
# PETGPT_MAX_JOB_ATTEMPTS=2

# ---- PetGPT tool calling (backend/config/ai.js) ----
# Bounds the tool-calling loop and result sizes. maxIterations caps how many
# tool-call rounds one generation may run (reaching it stops safely with no
# fabricated answer); maxResults caps records per read tool/pet context per
# category; maxContextPets caps pets injected into prompts.
# PETGPT_MAX_TOOL_ITERATIONS=3
# PETGPT_TOOL_MAX_RESULTS=10
# PETGPT_CONTEXT_MAX_PETS=5

# ---- PetGPT mutation tools & idempotency ----
# The model can create/complete reminders via the registered mutation tools
# only. Each successful mutation writes a MutationEffect ledger row keyed by
# (owner, sha256(jobId:tool:args)); a retried/re-enqueued job replays the
# recorded result instead of executing twice. No extra config.

# ---- PetGPT per-user generation quota (backend/config/ai.js) ----
# Backend-enforced fixed-window cap on durable generations per user. Counts
# the user's GenerationJobs in the window (the durable job collection IS the
# usage ledger); exceeded -> deterministic HTTP 429 before any message/job
# is persisted. Defaults: 30 generations / 60s window.
# PETGPT_RATE_LIMIT_MAX=30
# PETGPT_RATE_LIMIT_WINDOW_MS=60000

# ---- PetGPT end-to-end suites (backend/test/petgpt-e2e.test.js) ----
# The suites named *-e2e* are endpoint-agnostic: they run against
# whatever OpenAI-compatible endpoint PETGPT_OPENAI_BASE_URL points at and
# SKIP unless PETGPT_RUN_LIVE_E2E=1 is set (see test/db.js, which scrubs
# the real key so a normal `npm test` can never spend real quota).
#   PETGPT_RUN_LIVE_E2E=1
#   PETGPT_OPENAI_BASE_URL=http://localhost:20128/v1
#   PETGPT_OPENAI_API_KEY=dummy-key
#   PETGPT_OPENAI_MODEL=free-chat
#
# DOCKER: inside the container, "localhost" is the container itself. The root
# docker-compose.yml maps host.docker.internal -> host-gateway on the backend, so
# an endpoint published on a routable host address is reached by that stable
# name - never by a 172.x container IP, which changes on every recreate:
#   PETGPT_OPENAI_BASE_URL=http://host.docker.internal:<port>/v1
# An endpoint bound to host LOOPBACK only (127.0.0.1:<port>) is not reachable
# that way, because the gateway address is a different interface. Publishing it
# on a routable address is a deployment concern - FamiPet does not run, proxy,
# or depend on the endpoint's implementation, and its startup never waits on
# it. Either way the value is plain env config: no source change, no hardcoded
# IP, and every generation fails safely with a "provider" error while it is
# unset.


# ---- AI breed identification (backend/config/breed-ai.js) ----
# Optional, and NOT deployed by the Compose stack: unset/empty URL disables the
# feature (the endpoint just reports itself off). The backend only needs the
# base URL of the Python ML service in ai/ of this repository, which is run
# separately.
# Inside a container, reach a host-run service through the host gateway:
#   PET_BREED_AI_URL=http://host.docker.internal:<port>
# PET_BREED_AI_URL=
# PET_BREED_AI_TIMEOUT_MS=20000
# PET_BREED_MAX_UPLOAD_BYTES=8388608
# PET_BREED_AI_TOP_K=5
# PET_BREED_MIN_CONFIDENCE=0.35
# PET_BREED_MIN_CONFIDENCE_GENERIC=0.55
# PET_BREED_AI_ENRICH=true


# ---- Web Push / VAPID (backend/config/push.js) ----
# Browser push notifications. Generate a key pair ONCE per deployment and put
# the result in the deployment's own env file (they are deployment config, not
# per-request input, so they are read once at load time). NEVER write a real
# pair into this tracked example or any other committed file:
#
#   npx web-push generate-vapid-keys
#
# Push FAILS CLOSED: with these unset, or with a malformed pair, the whole app
# works exactly as before and push is simply off — GET
# /api/notifications/vapid-public-key then reports `configured: false` and the
# Settings toggle says push is not configured. Nothing throws at startup, and
# the PRIVATE key is never logged, echoed in an error, or returned by any
# endpoint.
#
# VAPID_SUBJECT must be a mailto: or an https: URL identifying this
# deployment; push services use it to contact you about a failing key.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@your-domain.example
#
# The browser also needs a SECURE CONTEXT: push and service workers only work
# over https, or on localhost. http:// on a LAN address is not enough, and the
# Settings toggle says so instead of pretending to work. Browsers also require
# an explicit user gesture before they will show the permission prompt, which
# is why the toggle lives in Settings and never fires on page load.
#
# `backend/.env` is loaded by the Compose backend service through `env_file:`,
# so the three variables above reach the container unchanged. Do NOT
# redeclare them in the `environment:` block, and never commit a real private
# key to a public repository.
