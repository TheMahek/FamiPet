# =========================================================
# AI (Breed Intelligence) - standalone configuration template
# =========================================================
# These are plain environment variables (ai/main.py reads os.environ; the
# service has no dotenv dependency). Copy this file to ai/.env (gitignored)
# and run the service on its own:
#
#   cd ai
#   set -a; . ./.env; set +a
#   uvicorn main:app --port 8000
#
# or pass overrides inline:  AI_TOP_K=10 uvicorn main:app --port 8000
#
# This is development/standalone configuration ONLY. The normal FamiPet
# deployment runs this service from the root docker-compose.yml, which maps
# the same variables from the root .env (root .env.example); Compose never
# reads this file.
# =========================================================

# Upload ceiling in bytes. 8 MB is comfortably above a phone photo; the
# Node backend enforces the same number so an oversized upload is rejected
# without a round trip.
AI_MAX_UPLOAD_BYTES=8388608

# Candidates returned per image. More than 5 is noise for a softmax over
# 1000 classes; fewer hides a useful runner-up.
AI_TOP_K=5

# Inference is CPU-bound sync work; bound it so one slow request cannot
# hold a worker forever.
AI_INFERENCE_TIMEOUT_S=20
